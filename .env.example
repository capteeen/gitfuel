# GitHub OAuth app. Least privilege: read:user is what the claim flow requests.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# Optional. Raises the public repo rate limit. Not a user token.
GITHUB_TOKEN=

# iron-session password, at least 32 characters. Replace the dev default.
SESSION_PASSWORD=

# Browser cluster: devnet (default) or mainnet-beta.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional browser RPC. Server routes prefer SOLANA_RPC_URL.
NEXT_PUBLIC_SOLANA_RPC_URL=
SOLANA_RPC_URL=

# Distinct from the launcher. Interim fee-share destination until a builder claim.
NEXT_PUBLIC_PLATFORM_TREASURY=
PLATFORM_TREASURY=

# Optional metadata pin. Without it, metadata is served by this app.
PINATA_JWT=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave empty until a real mint exists. The buyback page stays policy-only.
NEXT_PUBLIC_GFUL_MINT=
