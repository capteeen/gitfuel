# GitHub OAuth app. Least privilege: read:user is what the claim flow requests.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# Optional. Raises the public repo rate limit. Not a user token.
GITHUB_TOKEN=

# iron-session password, at least 32 characters. Replace the dev default.
SESSION_PASSWORD=

# Repo cache, metadata hosting, and claims on Vercel. Launches do not need Turso when
# Supabase public.markets is reachable.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supabase launch registry. The publishable key is client-safe. Do not put a secret key here.
# Launches are listed from the public.markets table. Apply supabase/migrations/20260930120000_markets.sql in the Supabase SQL editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional mainnet-beta RPC endpoints. Leave both empty to use the public mainnet RPC.
# That public endpoint rejects browser Origin headers with 403, so wallet and pump.fun
# reads go through /api/rpc unless NEXT_PUBLIC_SOLANA_RPC_URL is a different provider
# that allows your origin. SOLANA_RPC_URL is server-only (the proxy and confirmations).
# Put a keyed URL here when you have one. Do not commit the key.
NEXT_PUBLIC_SOLANA_RPC_URL=
SOLANA_RPC_URL=

# Distinct from the launcher. Interim fee-share destination until a builder claim.
NEXT_PUBLIC_PLATFORM_TREASURY=
PLATFORM_TREASURY=

# Optional metadata pin. Without it, metadata is served by this app.
PINATA_JWT=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# $GITFUEL mint, once one exists. The buyback page stays policy-only until then.
NEXT_PUBLIC_GFUL_MINT=
